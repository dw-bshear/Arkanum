{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "SqliteFallback": "Data Source=arkanum-dev.db"
  },
  "Arkanum": {
    "AuditRetentionDays": 90,
    "EncryptionKeyEnvironmentVariable": "ARKANUM_MASTER_KEY",
    "AllowRuntimeSchemaManagement": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
